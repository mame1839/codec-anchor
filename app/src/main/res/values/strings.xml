    <!-- Audio processing (EQ). "The audio processing module" is the separate root module that
         installs the effect. A bare "the module" is the one inside the Bluetooth process, which is
         what every other module_* string above means. -->
    <string name="eq_module_version_mismatch">The audio processing module (%1$s) and the app (%2$s) are different versions. Update both to the same version, then restart the phone.</string>
